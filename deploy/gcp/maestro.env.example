# Copy to .env in this folder (git-ignored) and edit:  cp maestro.env.example .env No secrets here: the API key and the
# admin passcode come from Google Secret Manager when start.sh runs.

# The address people type, e.g. maestro.example.com (its DNS A record points at the VM's IP)
MAESTRO_HOST=maestro.example.com

# First administrator's username (created only when there are no users yet)
MAESTRO_ADMIN_USER=admin

# Claude: true uses the Anthropic API key; false runs on the built-in rules only
AI_ENABLED=true
AI_MODEL=claude-opus-5-5

# Daily public risk feeds (needs outbound internet); false to switch off
RISK_FEEDS_ENABLED=true
